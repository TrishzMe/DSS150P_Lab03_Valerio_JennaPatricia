# Template for machine-specific settings and secrets.
#   cp .env.example .env      (then replace the training password)
# .env is git-ignored and must never be committed.

# PostgreSQL connection used by the pipeline.
# Host-side commands reach the published port on localhost. Docker Compose
# overrides POSTGRES_HOST=postgres and POSTGRES_PORT=5432 inside containers,
# so the same .env works in both contexts.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p
# Use URL-safe characters only (letters, digits, - and _): Airflow embeds it in a connection URL.
POSTGRES_PASSWORD=change_me

# Airflow web UI account created by airflow-init (local laboratory environment only).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Shared by the webserver and scheduler so the UI can fetch logs of running tasks.
AIRFLOW__WEBSERVER__SECRET_KEY=replace_with_a_random_string
